@@ -112,6 +112,22 @@ def report_client_singleton():
     return PLACEMENTCLIENT
 
 
+def reset_report_client_singleton():
+    """Close and forget the global placement client singleton.
+
+    The client keeps a pool of keep-alive HTTP connections to placement.
+    A process that uses the client and then forks worker processes must
+    call this before forking: otherwise every worker inherits the same
+    sockets, concurrent requests from different workers are interleaved
+    on them and the workers read each other's responses. Each worker
+    creates its own client on first use after this.
+    """
+    global PLACEMENTCLIENT
+    if PLACEMENTCLIENT is not None:
+        PLACEMENTCLIENT.close()
+        PLACEMENTCLIENT = None
+
+
